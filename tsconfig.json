{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@hookguard/schema": ["./packages/schema/src/index.ts"],
      "@hookguard/engine": ["./packages/engine/src/index.ts"],
      "@hookguard/express-consumer": [
        "./examples/express-consumer/src/index.ts"
      ]
    }
  },
  "include": ["packages/**/*.ts", "examples/**/*.ts", "vitest.config.mts"],
  "exclude": ["node_modules", "**/dist"]
}
